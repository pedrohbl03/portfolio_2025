# Sanity Configuration
# Get these values from your Sanity project at https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production

# API Token with Editor permissions (required for data migration)
# Get from: https://sanity.io/manage/project/YOUR_PROJECT_ID/api
# Permissions needed: Editor
SANITY_API_TOKEN="your_sanity_api_token"
